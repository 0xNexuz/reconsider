HOST=127.0.0.1
PORT=3100
# Guest sessions are on automatically for 127.0.0.1. Set true explicitly only for an approved judge-facing demo.
DEMO_GUEST_SESSIONS=false
DATABASE_PATH=./data/reconsider.sqlite
# Keep this server-side. Never commit .env or paste credentials into source.
YOUCAM_API_KEY=
# Live API submission requires both a key and explicit enablement.
YOUCAM_ENABLED=false
RENDER_DAILY_LIMIT=20
RENDER_USER_DAILY_LIMIT=5
