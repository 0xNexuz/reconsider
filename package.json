{
  "name": "reconsider-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "build:hosted": "node scripts/build-hosted.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:hosted": "tsc -p tsconfig.hosted.json",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "catalog:image": "node --env-file-if-exists=.env --import tsx src/catalog-image.ts",
    "catalog:stock": "node --env-file-if-exists=.env --import tsx src/catalog-stock.ts",
    "integration:check": "node --env-file-if-exists=.env --import tsx src/integration-check.ts",
    "live:one": "node --env-file-if-exists=.env --import tsx src/live-one.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "sharp": "^0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
